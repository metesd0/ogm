<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Ogm.Agent</AssemblyName>
    <RootNamespace>Ogm.Agent</RootNamespace>

    <Version>1.0.0</Version>
    <Product>Ogm Print Agent</Product>
    <AssemblyTitle>Ogm Print Agent</AssemblyTitle>
    <Description>Windows yazici islerini yakalayip merkezi sunucuya gonderen ajan.</Description>

    <!-- Single-file & self-contained (zero-dependency) yayin icin hazir RID'ler -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Single-file yayinda boyutu kucultmek icin kullanilir (yalnizca publish'i etkiler) -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Hata ayiklama sembollerini tek dosyaya gomer (dagitim sadeligini artirir) -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ogm.Shared\Ogm.Shared.csproj" />
  </ItemGroup>

</Project>
